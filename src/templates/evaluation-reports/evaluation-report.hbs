    <div class="report-header">
        {{#if settings.useImages}}
        <img src="{{settings.logoUrl}}" alt="School Logo" class="header-logo">
        {{else}}
        <div style="width: 100px;"></div>
        {{/if}}
        <div class="header-content">
            <h1 class="report-title">{{#if settings.reportTitle}}{{settings.reportTitle}}{{else}}Evaluation
                Report{{/if}}</h1>
            <p class="report-subtitle">{{student.className}}</p>
        </div>
        <div style="width: 100px;"></div>
    </div>
    <div class="student-info">
        <h2>{{student.name}}</h2>
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Class</div>
                <div class="info-value">{{student.className}}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Period</div>
                <div class="info-value">{{student.ageFrom}} - {{student.ageTo}}</div>
            </div>
        </div>
    </div>
    <div class="eval-table-wrapper">
        <table class="eval-table">
            <thead>
                <tr>
                    <th class="subject-col">Subject</th>
                    <th class="item-col">Item</th>
                    {{#each terms}}
                    <th class="term-col">{{this.name}}</th>
                    {{/each}}
                </tr>
            </thead>
            <tbody>
                {{#each subjects}}
                <tr class="subject-title-row">
                    <td colspan="{{add terms.length 2}}">{{this.name}}</td>
                </tr>
                {{#each this.categories}}
                {{#if this.name}}
                <tr class="category-row">
                    <td></td>
                    <td colspan="{{add ../terms.length 1}}">{{this.name}}</td>
                </tr>
                {{/if}}
                {{#each this.items}}
                <tr class="item-row">
                    <td></td>
                    <td>{{this.name}}</td>
                    {{#each this.grades}}
                    <td class="grade-cell grade-{{#if this}}{{this}}{{else}}none{{/if}}">{{#if
                        this}}{{this}}{{else}}-{{/if}}</td>
                    {{/each}}
                </tr>
                {{/each}}
                {{#each this.subcategories}}
                <tr class="subcategory-row">
                    <td></td>
                    <td colspan="{{add ../../terms.length 1}}">{{this.name}}</td>
                </tr>
                {{#each this.items}}
                <tr class="item-row">
                    <td></td>
                    <td>{{this.name}}</td>
                    {{#each this.grades}}
                    <td class="grade-cell grade-{{#if this}}{{this}}{{else}}none{{/if}}">{{#if
                        this}}{{this}}{{else}}-{{/if}}</td>
                    {{/each}}
                </tr>
                {{/each}}
                {{/each}}
                {{/each}}
                {{/each}}
            </tbody>
        </table>
    </div>
    <div class="remarks-section">
        <h3>Remarks & Attendance</h3>
        <div class="remarks-grid">
            {{#each terms}}
            <div class="remark-card">
                <h4>{{this.name}}</h4>
                {{#if this.remark}}
                <p class="remark-text">{{this.remark}}</p>
                {{/if}}
                <div class="attendance-info">
                    <span>Attendance:</span>
                    <span class="attendance-badge">{{this.attendance}}</span>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    {{#if settings.includeFooter}}
    <div class="legend-section">
        <h3>Grading Legend</h3>
        <div class="legend-grid">
            {{#each legend}}
            <div class="legend-item">
                <div class="legend-badge grade-{{this.value}}">{{this.value}}</div>
                <span>{{this.name}}</span>
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
</body>

</html> --}}




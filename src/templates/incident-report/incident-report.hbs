<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Incident Report - {{student.name}}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 10pt;
        }

        .first-page-header-container {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            padding: 0 25px;
            box-sizing: border-box;
        }

        .first-page-header-container img {
            width: 100%;
            height: auto;
            display: block;
        }

        .header-spacer {
            height: 90px;
        }

        .center-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 10px;
        }

        .center-header img {
            width: 70px;
            height: 70px;
            object-fit: contain;
        }

        .center-header .center-info h2 {
            margin: 0 0 4px;
        }

        .center-header .center-info p {
            margin: 2px 0;
            font-size: 10pt;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 6px;
            text-align: left;
            word-wrap: break-word;
        }

        th {
            width: 220px;
            white-space: nowrap;
        }

        .signatures {
            display: flex;
            justify-content: space-between;
            margin-top: 60px;
            padding: 0 20px;
        }

        .signatures span {
            font-weight: bold;
        }
    </style>
</head>

<body>

    {{#if settings.useImages}}
    {{#if settings.headerImageBase64}}
    <div class="first-page-header-container">
        <img src="{{settings.headerImageBase64}}" alt="Report Header" />
    </div>

    <div class="header-spacer"></div>
    {{/if}}
    {{/if}}

    <div class="center-header">
        {{#if center.logoBase64}}
        <img src="{{center.logoBase64}}" alt="Center Logo" onerror="this.style.display='none';" />
        {{/if}}
        <div class="center-info">
            <h2>{{center.name}}</h2>
            {{#if center.address}}
            <p>{{center.address}}</p>
            {{/if}}
            {{#if center.landLine}}
            <p>Phone: {{center.landLine}}</p>
            {{/if}}
        </div>
    </div>

    <h1 style="text-align: center;">Incident Report</h1>

    <table>
        <tbody>
            <tr>
                <th>Child Name:</th>
                <td>{{student.name}}</td>
            </tr>
            <tr>
                <th>Date of Incident:</th>
                <td>{{incident.date}}</td>
            </tr>
            <tr>
                <th>Time of Incident:</th>
                <td>{{incident.time}}</td>
            </tr>
            <tr>
                <th>Reported by:</th>
                <td>{{incident.reportedByName}}</td>
            </tr>
            <tr>
                <th>Incident Title:</th>
                <td>{{incident.title}}</td>
            </tr>
            <tr>
                <th>Incident Description:</th>
                <td>{{incident.description}}</td>
            </tr>
            <tr>
                <th>Parent Contacted:</th>
                <td>
                    {{#if incident.parentContacted}}Yes at {{incident.parentContactTime}}{{else}}No{{/if}}
                </td>
            </tr>
            <tr>
                <th>Actions Taken:</th>
                <td>{{incident.actionsTaken}}</td>
            </tr>
            <tr>
                <th>Recommended Follow up:</th>
                <td>{{incident.recommendedFollowUp}}</td>
            </tr>
        </tbody>
    </table>

    <div class="signatures">
        <span>Manager Signature</span>
        <span>Nurse Signature</span>
        <span>Parent Signature</span>
    </div>

</body>

</html>

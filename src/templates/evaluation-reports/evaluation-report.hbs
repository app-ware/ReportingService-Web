<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Evaluation Report - {{childInfo.name}}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 10pt;
        }

        .first-page-header-container {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            padding: 0 25px;
            box-sizing: border-box;
        }

        .first-page-header-container img {
            width: 100%;
            height: auto;
            display: block;
        }

        .header-spacer {
            height: 90px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 6px;
            text-align: left;
            word-wrap: break-word;
        }

        .student-info p {
            margin: 4px 0;
        }

        .full-width-image {
            width: 100%;
            height: auto;
        }

        .remark {
            margin-top: 1em;
            padding: 1em;
            background-color: #f9f9f9;
            border-left: 3px solid #ccc;
        }
    </style>
</head>

<body>

    {{#if settings.useImages}}
    {{#if settings.headerImageBase64}}
    <div class="first-page-header-container">
        <img src="{{settings.headerImageBase64}}" alt="Report Header" />
    </div>

    <div class="header-spacer"></div>
    {{/if}}
    {{/if}}

    <h1 style="text-align: center;">Evaluation Report</h1>
    <div>
        <hr>
        <div class="student-info" style="
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                    gap: 8px 16px;
                    background-color: #f9f9f9;
                    padding: 10px 15px;
                    border-radius: 10px;
                    border: 1px solid #ddd;
                    margin: 10px auto;
                    width: 90%;
                    font-family: Arial, sans-serif;
                    font-size: 14px;
                    color: #333;
                ">

            <div>
                <strong>{{variants.label_student_name}}</strong>
                <span>{{childInfo.name}}</span>
            </div>

            <div>
                <strong>{{variants.label_class}}</strong>
                <span>{{childInfo.class}}</span>
            </div>

            {{#if settings.showAge}}
            <div>
                <strong>{{variants.label_age}}</strong>
                <span>
                    {{childInfo.age}}
                    ({{variants.label_from}} {{childInfo.dateFrom}} {{variants.label_to}} {{childInfo.dateTo}})
                </span>
            </div>
            {{/if}}

            {{#if settings.showAttendance}}
            <div>
                <strong>{{variants.label_attendance}}</strong>
                <span>{{childInfo.attendance}}</span>
            </div>
            {{/if}}

            {{#if settings.showTeacher}}
            <div>
                <strong>{{variants.label_teacher}}</strong>
                <span>{{childInfo.teacher}}</span>
            </div>
            {{/if}}
        </div>
    </div>

    <main>
        <table>
            <thead>
                <tr
                    style="background-color: {{variants.term_title_background_color}}; color: {{variants.term_title_text_color}};">
                    <th>Item</th>
                    {{#each terms}}
                    <th style="text-align: center;">{{this.title}}</th>
                    {{/each}}
                </tr>
            </thead>
            <tbody>
                {{#each nodes}}
                {{> node}}
                {{/each}}
            </tbody>
        </table>

        {{#if globalRemark}}
        <div class="global-remark"
            style="margin-top: 25px; padding: 12px; border: 1px solid #ccc; background-color: #f9f9f9; page-break-inside: avoid;">
            <h4 style="margin-top: 0;">{{variants.label_remark_global}}</h4>
            <p style="margin-bottom: 0;">{{globalRemark}}</p>
        </div>
        {{/if}}



        {{#if legend}}
        <div class="legend-section" style="margin-top: 25px; page-break-inside: avoid;">
            <h4 style="text-align:center">{{variants.label_legend}}</h4>
            <table style="margin: 0 auto; width: 40%; border-collapse: collapse;">
                <tbody>
                    {{#each legend}}
                    <tr>
                        <td>{{this.value}}:</td>
                        <td>{{this.text}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>

        </div>
        {{/if}}
    </main>
</body>

</html>
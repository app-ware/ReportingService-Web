<!DOCTYPE html>
<html lang="{{lang}}" dir="{{dir}}">

<head>
    <meta charset="UTF-8">
    <title>{{labels.report.documentTitle}} - {{student.name}}</title>
    <style>
        {{{fontFaceCss}}}

        body {
            font-family: {{fontStack}};
            font-size: 10pt;
        }

{{> report-banner-styles}}

        .center-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 10px;
        }

        .center-header img {
            width: 70px;
            height: 70px;
            object-fit: contain;
        }

        .center-header .center-info h2 {
            margin: 0 0 4px;
        }

        .center-header .center-info p {
            margin: 2px 0;
            font-size: 10pt;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 6px;
            text-align: start;
            word-wrap: break-word;
        }

        th {
            width: 220px;
            white-space: nowrap;
        }

        .signatures {
            display: flex;
            justify-content: space-between;
            margin-top: 60px;
            padding: 0 20px;
        }

        .signatures span {
            font-weight: bold;
        }
    </style>
</head>

<body>

    {{> report-banner}}

    <div class="center-header">
        {{#if center.logoBase64}}
        {{! onerror is a static attribute of this template, not payload data — it is the
            second, independent branding safety net Nursery's logo fallback relies on. }}
        <img src="{{center.logoBase64}}" alt="" onerror="this.style.display='none';" />
        {{/if}}
        <div class="center-info">
            <h2>{{center.name}}</h2>
            {{#if center.address}}
            <p>{{center.address}}</p>
            {{/if}}
            {{#if center.landLine}}
            <p>{{labels.common.phone}}: {{center.landLine}}</p>
            {{/if}}
        </div>
    </div>

    <h1 style="text-align: center;">{{labels.report.heading}}</h1>

    <table>
        <tbody>
            <tr>
                <th>{{labels.report.studentName}}</th>
                <td>{{student.name}}</td>
            </tr>
            <tr>
                <th>{{labels.report.incidentDate}}</th>
                <td>{{incident.date}}</td>
            </tr>
            <tr>
                <th>{{labels.report.incidentTime}}</th>
                <td>{{incident.time}}</td>
            </tr>
            <tr>
                <th>{{labels.report.reportedBy}}</th>
                <td>{{incident.reportedByName}}</td>
            </tr>
            <tr>
                <th>{{labels.report.incidentTitle}}</th>
                <td>{{incident.title}}</td>
            </tr>
            <tr>
                <th>{{labels.report.incidentDescription}}</th>
                <td>{{incident.description}}</td>
            </tr>
            <tr>
                <th>{{labels.report.parentContacted}}</th>
                <td>
                    {{#if incident.parentContacted}}{{labels.common.yes}}{{#if incident.parentContactTime}}
                    {{labels.common.at}} {{incident.parentContactTime}}{{/if}}{{else}}{{labels.common.no}}{{/if}}
                </td>
            </tr>
            <tr>
                <th>{{labels.report.actionsTaken}}</th>
                <td>{{incident.actionsTaken}}</td>
            </tr>
            <tr>
                <th>{{labels.report.recommendedFollowUp}}</th>
                <td>{{incident.recommendedFollowUp}}</td>
            </tr>
        </tbody>
    </table>

    <div class="signatures">
        <span>{{labels.report.managerSignature}}</span>
        <span>{{labels.report.nurseSignature}}</span>
        <span>{{labels.report.parentSignature}}</span>
    </div>

</body>

</html>

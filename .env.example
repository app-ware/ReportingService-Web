# Application
PORT=4445

# Required internal authentication shared with NurseryServices-Web
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Conservative renderer defaults. Tune only from bounded load tests.
REPORT_RENDER_TIMEOUT_MS=20000
REPORT_MAX_CONCURRENT_RENDERS=2
REPORT_MAX_QUEUE_DEPTH=10
REPORT_QUEUE_TIMEOUT_MS=10000
REPORT_MAX_PAYLOAD_BYTES=5242880
REPORT_MAX_IMAGE_BYTES=2097152

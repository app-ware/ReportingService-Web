<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Evaluation Report - {{student.name}}</title>
    <style>
        /* A4 Page Setup for Print */
        @page {
            size: A4;
            margin: 15mm;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', 'Helvetica', sans-serif;
            font-size: 10pt;
            line-height: 1.4;
            color: #2d3748;
            background: #ffffff;
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            padding: 15mm;
        }

        /* Header Section */
        .report-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 8mm;
            margin-bottom: 5mm;
            border-bottom: 2px solid #2563eb;
        }

        .header-logo {
            max-width: 70px;
            max-height: 50px;
        }

        .header-content {
            flex: 1;
            text-align: center;
            padding: 0 10mm;
        }

        .report-title {
            font-size: 18pt;
            font-weight: 700;
            color: #1e40af;
            margin-bottom: 2mm;
        }

        .report-subtitle {
            font-size: 10pt;
            color: #64748b;
        }

        /* Student Info Section */
        .student-info {
            background-color: #f1f5f9;
            border: 1px solid #cbd5e1;
            padding: 4mm;
            margin-bottom: 5mm;
        }

        .student-name {
            font-size: 13pt;
            font-weight: 700;
            color: #1e40af;
            margin-bottom: 3mm;
        }

        .info-row {
            display: flex;
            flex-wrap: wrap;
            gap: 3mm;
        }

        .info-item {
            flex: 1;
            min-width: 35mm;
            padding: 2mm;
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
        }

        .info-label {
            font-size: 8pt;
            color: #64748b;
            margin-bottom: 1mm;
            font-weight: 600;
        }

        .info-value {
            font-size: 9pt;
            color: #1e293b;
            font-weight: 600;
        }

        /* Evaluation Table */
        .eval-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5mm;
            border: 1px solid #94a3b8;
        }

        .eval-table thead tr {
            background-color: #2563eb;
            color: #ffffff;
        }

        .eval-table th {
            padding: 3mm 2mm;
            font-weight: 700;
            text-align: center;
            font-size: 10pt;
            border: 1px solid #1e40af;
        }

        .eval-table th.subject-col {
            width: 22%;
            text-align: left;
        }

        .eval-table th.item-col {
            text-align: left;
        }

        .eval-table tbody tr {
            border-bottom: 1px solid #cbd5e1;
        }

        .eval-table td {
            padding: 2mm;
            border: 1px solid #cbd5e1;
            font-size: 9pt;
        }

        .subject-title-row td {
            background-color: #dbeafe;
            font-weight: 700;
            font-size: 10pt;
            color: #1e40af;
            padding: 3mm 2mm;
            text-align: left;
            border: 1px solid #93c5fd;
        }

        .category-row td {
            background-color: #f1f5f9;
            font-weight: 600;
            color: #475569;
            padding: 2mm;
            text-align: left;
        }

        .subcategory-row td {
            background-color: #f8fafc;
            font-style: italic;
            color: #64748b;
            padding: 2mm 2mm 2mm 6mm;
            text-align: left;
        }

        .item-row td:first-child {
            background-color: #fafafa;
        }

        .item-row td:nth-child(2) {
            text-align: left;
            padding-left: 4mm;
        }

        .grade-cell {
            text-align: center;
            font-weight: 700;
            font-size: 10pt;
            background-color: #ffffff;
        }

        /* Grade Colors */
        .grade-1 {
            color: #16a34a;
        }

        .grade-2 {
            color: #2563eb;
        }

        .grade-3 {
            color: #ca8a04;
        }

        .grade-4 {
            color: #ea580c;
        }

        .grade-5 {
            color: #dc2626;
        }

        /* Remarks Section */
        .remarks-section {
            margin-top: 5mm;
            padding: 4mm;
            background-color: #f8fafc;
            border: 1px solid #cbd5e1;
        }

        .remarks-title {
            font-size: 11pt;
            color: #1e40af;
            margin-bottom: 3mm;
            font-weight: 700;
            padding-bottom: 2mm;
            border-bottom: 2px solid #2563eb;
        }

        .remark-item {
            margin-bottom: 3mm;
            padding: 2mm;
            background-color: #ffffff;
            border-left: 3px solid #2563eb;
        }

        .remark-item:last-child {
            margin-bottom: 0;
        }

        .remark-term {
            font-weight: 700;
            color: #1e40af;
            font-size: 10pt;
            margin-bottom: 1mm;
        }

        .remark-text {
            color: #475569;
            margin-bottom: 2mm;
            line-height: 1.5;
        }

        .attendance-row {
            display: flex;
            align-items: center;
            gap: 2mm;
            font-size: 9pt;
            color: #64748b;
        }

        .attendance-value {
            background-color: #dbeafe;
            color: #1e40af;
            padding: 1mm 2mm;
            border-radius: 2mm;
            font-weight: 700;
        }

        /* Legend Section */
        .legend-section {
            margin-top: 5mm;
            padding: 4mm;
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
        }

        .legend-title {
            font-size: 11pt;
            color: #1e40af;
            margin-bottom: 3mm;
            font-weight: 700;
        }

        .legend-items {
            display: flex;
            flex-wrap: wrap;
            gap: 2mm;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 2mm;
            padding: 2mm;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            min-width: 32mm;
        }

        .legend-number {
            width: 7mm;
            height: 7mm;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-weight: 700;
            color: #ffffff;
            font-size: 9pt;
        }

        .legend-number.grade-1 {
            background-color: #16a34a;
        }

        .legend-number.grade-2 {
            background-color: #2563eb;
        }

        .legend-number.grade-3 {
            background-color: #ca8a04;
        }

        .legend-number.grade-4 {
            background-color: #ea580c;
        }

        .legend-number.grade-5 {
            background-color: #dc2626;
        }

        .legend-text {
            font-size: 9pt;
            color: #475569;
        }

        /* Print Optimization */
        @media print {
            body {
                margin: 0;
                padding: 15mm;
            }

            .eval-table {
                page-break-inside: auto;
            }

            .eval-table tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }

            .subject-title-row {
                page-break-after: avoid;
            }

            .remarks-section,
            .legend-section {
                page-break-inside: avoid;
            }
        }
    </style>
</head>

<body>
    <!-- Header Section -->
    <div class="report-header">
        {{#if settings.useImages}}
        <img src="{{settings.logoUrl}}" alt="School Logo" class="header-logo">
        {{else}}
        <div style="width: 70px;"></div>
        {{/if}}

        <div class="header-content">
            <h1 class="report-title">{{#if settings.reportTitle}}{{settings.reportTitle}}{{else}}Evaluation
                Report{{/if}}</h1>
            <p class="report-subtitle">Academic Performance Assessment</p>
        </div>

        <div style="width: 70px;"></div>
    </div>

    <!-- Student Information -->
    <div class="student-info">
        <div class="student-name">{{student.name}}</div>
        <div class="info-row">
            <div class="info-item">
                <div class="info-label">Class</div>
                <div class="info-value">{{student.className}}</div>
            </div>
            {{#if student.age}}
            <div class="info-item">
                <div class="info-label">Age</div>
                <div class="info-value">{{student.age}}</div>
            </div>
            {{/if}}
            <div class="info-item">
                <div class="info-label">From</div>
                <div class="info-value">{{student.ageFrom}}</div>
            </div>
            <div class="info-item">
                <div class="info-label">To</div>
                <div class="info-value">{{student.ageTo}}</div>
            </div>
            {{#if student.teachers}}
            <div class="info-item">
                <div class="info-label">Teacher</div>
                <div class="info-value">{{student.teachers}}</div>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- Evaluation Table -->
    <table class="eval-table">
        <thead>
            <tr>
                <th class="subject-col">Subject</th>
                <th class="item-col">Item</th>
                {{#each terms}}
                <th>{{this.name}}</th>
                {{/each}}
            </tr>
        </thead>
        <tbody>
            {{#each subjects}}
            <!-- Subject Title Row -->
            <tr class="subject-title-row">
                <td colspan="{{#if ../terms}}{{add ../terms.length 2}}{{else}}2{{/if}}">{{this.name}}</td>
            </tr>

            {{#each this.categories}}
            <!-- Category Row -->
            {{#if this.name}}
            <tr class="category-row">
                <td></td>
                <td colspan="{{#if ../../terms}}{{add ../../terms.length 1}}{{else}}1{{/if}}">{{this.name}}</td>
            </tr>
            {{/if}}

            <!-- Category Items -->
            {{#each this.items}}
            <tr class="item-row">
                <td></td>
                <td>{{this.name}}</td>
                {{#each this.grades}}
                <td class="grade-cell grade-{{this}}">{{this}}</td>
                {{/each}}
            </tr>
            {{/each}}

            <!-- Subcategories -->
            {{#each this.subcategories}}
            <tr class="subcategory-row">
                <td></td>
                <td colspan="{{#if ../../../terms}}{{add ../../../terms.length 1}}{{else}}1{{/if}}">{{this.name}}</td>
            </tr>
            {{#each this.items}}
            <tr class="item-row">
                <td></td>
                <td>{{this.name}}</td>
                {{#each this.grades}}
                <td class="grade-cell grade-{{this}}">{{this}}</td>
                {{/each}}
            </tr>
            {{/each}}
            {{/each}}
            {{/each}}
            {{/each}}
        </tbody>
    </table>

    <!-- Remarks and Attendance -->
    <div class="remarks-section">
        <div class="remarks-title">Remarks & Attendance</div>
        {{#each terms}}
        <div class="remark-item">
            <div class="remark-term">{{this.name}}</div>
            {{#if this.remark}}
            <div class="remark-text">{{this.remark}}</div>
            {{/if}}
            <div class="attendance-row">
                <span>Attendance:</span>
                <span class="attendance-value">{{this.attendance}}</span>
            </div>
        </div>
        {{/each}}
    </div>

    <!-- Legend -->
    {{#if settings.includeFooter}}
    <div class="legend-section">
        <div class="legend-title">Grading Legend</div>
        <div class="legend-items">
            {{#each legend}}
            <div class="legend-item">
                <div class="legend-number grade-{{this.value}}">{{this.value}}</div>
                <span class="legend-text">{{this.name}}</span>
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
</body>

</html> --}}




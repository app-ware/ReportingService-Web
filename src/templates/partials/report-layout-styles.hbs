        /*
         * First-page header banner. Each center uploads its own image, so nothing here
         * may assume a size or aspect ratio: the banner stays in normal flow (content is
         * always pushed below it, never overlapped) and is capped in height, with
         * object-fit keeping a tall or square image whole and centered inside the cap.
         */
        .report-banner {
            margin: 0 0 16px;
            break-inside: avoid;
        }

        .report-banner img {
            display: block;
            width: 100%;
            height: auto;
            max-height: 110px;
            object-fit: contain;
        }

        body.compact .report-banner img {
            max-height: 70px;
        }

        body.compact.installment-slip .report-banner img {
            /*
             * Printable-report images are uploaded at 1600x230. At A5 landscape width
             * they need roughly 108px of height to keep their aspect ratio and reach
             * both sides of the installment slip. The compact 70px cap reduced the width.
             */
            max-height: 110px;
        }

        /*
         * A short report fills its page: the spacer takes the leftover height, so the
         * signatures and the footer banner sit at the bottom of the page instead of
         * leaving the white space under them. `pageFillHeight` is the printable height
         * computed by the render pipeline, minus the body's default 8px margins. A longer
         * report simply grows past it and the closing blocks follow the content.
         */
        .page-fill {
            display: flex;
            flex-direction: column;
            min-height: calc({{pageFillHeight}} - 16px);
        }

        .page-fill-spacer {
            flex: 1 0 auto;
        }

        /* Footer banner, printed once at the end of the document — not on every page. */
        .report-footer-banner {
            margin-top: 16px;
            break-inside: avoid;
        }

        .report-footer-banner img {
            display: block;
            width: 100%;
            height: auto;
            max-height: 100px;
            object-fit: contain;
        }

        body.compact.installment-slip .report-footer-banner img {
            /* Match the full-width A5 installment treatment used by the header banner. */
            max-height: 110px;
        }

        /*
         * Receipt and invoice use the same four fixed legacy text-signature positions.
         * A hidden slot stays in its column instead of making later captions shift.
         */
        .accounting-report-closing {
            break-inside: avoid;
        }

        .accounting-fineprint,
        .accounting-signature-note,
        .accounting-footer-message {
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .accounting-fineprint {
            margin: 0 0 14px;
        }

        .accounting-signatures {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            align-items: end;
            margin-top: 28px;
            /*
             * Keep a writable area below the labels. Because the closing block is
             * anchored at the bottom of a short report, this padding moves the labels
             * upward while leaving room for a handwritten signature.
             */
            padding-bottom: 64px;
        }

        .accounting-signature {
            min-width: 0;
            text-align: center;
            break-inside: avoid;
        }

        .accounting-signature-note {
            font-weight: 600;
        }

        .accounting-footer-message {
            margin: 18px 0 0;
            padding-top: 9px;
            border-top: 1px solid #333;
            text-align: center;
        }

        body.compact .accounting-signatures {
            gap: 10px;
            margin-top: 18px;
            /* Preserve the tight one-page A5 receipt layout. */
            padding-bottom: 0;
        }

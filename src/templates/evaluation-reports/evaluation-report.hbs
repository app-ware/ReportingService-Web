<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Evaluation Report for {{student.name}}</title>
    <style>
        body {
            font-family: sans-serif;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        .header-row th {
            color: {
                    {
                    reportStyles.termTitleTextColor
                }
            }

            ;

            background-color: {
                    {
                    reportStyles.termTitleBackgroundColor
                }
            }

            ;
        }

        .subject-title {
            color: {
                    {
                    reportStyles.titleTextColor
                }
            }

            ;

            background-color: {
                    {
                    reportStyles.titleBackgroundColor
                }
            }

            ;
        }
    </style>
</head>

<body>

    {{#if settings.useImages}}
    {{> customHeader}}
    {{else}}
    <h1>Evaluation Report</h1>
    <p><strong>Student:</strong> {{student.name}}</p>
    <p><strong>Class:</strong> {{student.className}}</p>
    <p><strong>Age:</strong> From {{student.ageFrom}} To {{student.ageTo}}</p>
    {{/if}}

    <table>
        <thead>
            <tr class="header-row">
                <th style="width: 20%;">Subject</th>
                <th style="width: {{reportStyles.itemColumnWidth}};">Item</th>

                {{#each terms}}
                <th style="text-align: center;">{{this.name}}</th>
                {{/each}}
            </tr>
        </thead>
        <tbody>

            {{#each subjects}}
            <tr>
                <td class="subject-title" colspan="{{add ../terms.length 2}}">{{this.name}}</td>
            </tr>

            {{#each this.categories}}

            {{#if this.name}}
            <tr>
                <td></td>
                <td colspan="{{add ../../terms.length 1}}"><strong>{{this.name}}</strong></td>
            </tr>
            {{/if}}


            {{#each this.items}}
            <tr>
                <td></td>
                <td>{{this.name}}</td>
                {{#each this.grades}}
                <td style="text-align: center;">{{this}}</td>
                {{/each}}
            </tr>
            {{/each}}


            {{#each this.subcategories}}
            <tr>
                <td></td>
                <td colspan="{{add ../../../terms.length 1}}"><em>{{this.name}}</em></td>
            </tr>
            {{#each this.items}}
            <tr>
                <td></td>
                <td>{{this.name}}</td>
                {{#each this.grades}}
                <td style="text-align: center;">{{this}}</td>
                {{/each}}
            </tr>
            {{/each}}
            {{/each}}
            {{/each}}
            {{/each}}
        </tbody>
    </table>

    <hr>
    <h3>Remarks & Attendance</h3>

    {{#each terms}}
    {{#if this.remark}}
    <p><strong>{{this.name}} Remark:</strong> {{this.remark}}</p>
    {{/if}}
    <p><strong>{{this.name}} Attendance:</strong> {{this.attendance}}</p>
    {{/each}}


    {{#if settings.includeFooter}}
    <div class="page-break" style="page-break-before: always;"></div>
    <h2>Legend</h2>
    <table>
        {{#each legend}}
        <tr>
            <td>{{this.name}}</td>
            <td>{{this.value}}</td>
        </tr>
        {{/each}}
    </table>
    {{/if}}

</body>

</html> --}}


